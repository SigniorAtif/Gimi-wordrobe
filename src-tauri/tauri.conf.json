{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skin Switcher",
  "version": "0.2.1",
  "identifier": "com.signioratif.skinswitcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skin Switcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0f1014",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Atif Ahmed",
    "homepage": "https://github.com/SigniorAtif/Gimi-wordrobe",
    "category": "Utility",
    "shortDescription": "Choose which mod skin each Genshin character wears",
    "longDescription": "Skin Switcher keeps one active mod skin per character for GIMI / XXMI (3DMigoto). Inactive skins wait in a library outside the Mods folder, and every switch is a journaled batch that rolls back on failure.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/hash_index.json"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English"
        ],
        "compression": "lzma"
      }
    }
  }
}
